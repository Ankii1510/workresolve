# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets, private keys, or seed phrases.
# .env.example is intentionally the one exception: it only contains
# placeholders and documents which variables the app expects.
.env*
!.env.example

# Encrypted account keystores (`genlayer account export --output …`). These are
# what scripts/deploy-contract.mjs and scripts/upgrade-contract.mjs decrypt to
# sign with, and the account inside is the SOLE UPGRADER of every contract it
# deployed — on every network. An encrypted keystore is only as safe as its
# password, so it is never committed, not even to a private repo.
*keystore*.json
upgrader-keystore.json

# secrets / keys — belt-and-braces, in case anything gets dropped here locally
*.key
*.pem
*private*key*
secrets/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python (contracts/)
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
